# Public site URL used for canonical links, Open Graph, sitemap, and robots.
# No trailing slash. The default in code is https://ovoralabs.com, taken from
# the support email. Set this to the domain registered at Namecheap if it differs,
# and set the same value in the host's environment before building.
NEXT_PUBLIC_SITE_URL=https://ovoralabs.com

# Tidio / Lyro
# Get this from Tidio dashboard → Settings → Developer → Project data (Public key)
# Script loads as: https://code.tidio.co/<PUBLIC_KEY>.js
# Leave blank to hide the chat widget.
NEXT_PUBLIC_TIDIO_PUBLIC_KEY=
